{
  "name": "angular-prod-guard",
  "displayName": "Angular Prod Guard",
  "description": "Warns if production build script is missing in package.json before git push",
  "version": "0.0.1",
  "publisher": "omganeshganesh91",
  "repository": {
    "type": "git",
    "url": "https://github.com/<your-username>/angular-prod-guard"
  },
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Other"],
  "keywords": ["angular", "production", "build", "guard", "package.json"],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "angularProdGuard.check",
        "title": "Angular Prod Guard: Check Production Build Script"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  }
}
